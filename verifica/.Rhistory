P_A_given_NS <- (P_A * P_NS_A) / P_NS
P_A_given_NS
cat("P(Non Supera) =", round(P_S, 4), "\n")
cat("P(A | Non Supera) =", round(P_A_given_NS, 4), "\n")
x <- c(39, 41, 40, 38, 43, 37)
mu0 <- 42
alpha <- 0.05
n <- length(x)
xbar <- mean(x)
s <- sd(x)              # deviazione standard campionaria corretta
se <- s / sqrt(n)
# 1) Intervallo di confidenza al 95% per mu.
t_star <- qt(1 - alpha / 2, df = n - 1)
IC <- c(xbar - t_star * se, xbar + t_star * se)
cat("Media campionaria =", round(xbar, 4), "\n")
cat("Deviazione standard campionaria =", round(s, 4), "\n")
cat("IC 95% per mu = [", round(IC[1], 4), ", ", round(IC[2], 4), "]\n", sep = "")
# 2) Test H0: mu >= 42 vs H1: mu < 42 con valore critico.
t_obs <- (xbar - mu0) / se
t_crit <- qt(alpha, df = n - 1)
cat("Statistica osservata t =", round(t_obs, 4), "\n")
cat("Valore critico t_alpha, df=5 =", round(t_crit, 4), "\n")
if (t_obs < t_crit) {
cat("Decisione: si rifiuta H0 al livello alpha = 0.05.\n")
} else {
cat("Decisione: non si rifiuta H0 al livello alpha = 0.05.\n")
}
