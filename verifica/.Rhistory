x <- c(4, 4.5, 5.5, 6, 7, 7.5, 8.5)
y <- c(20.5, 21.0, 22.4, 23.1, 24.0, 25.2, 26.1)
df <- data.frame(x = x, y = y)
# Stima manuale dei parametri.
Mx <- mean(x)
My <- mean(y)
Sxx <- mean(x^2) - Mx^2
Sxy <- mean(x * y) - Mx * My
Syy <- mean(y^2) - My^2
b_hat <- Sxy / Sxx
a_hat <- My - b_hat * Mx
cat("Retta stimata: y_hat =", round(a_hat, 4), "+", round(b_hat, 4), "x\n")
cat("Interpretazione: per ogni ora aggiuntiva di preparazione, il punteggio\n")
cat("medio atteso aumenta di circa", round(b_hat, 4), "punti.\n")
# Bontà di adattamento.
r <- Sxy / sqrt(Sxx * Syy)
R2 <- r^2
cat("Coefficiente di correlazione r =", round(r, 4), "\n")
cat("Indice di determinazione R^2 =", round(R2, 4), "\n")
# Previsione per 13 ore.
x0 <- 6.5
y0_hat <- a_hat + b_hat * x0
cat("Punteggio medio atteso per 6.5 ore =", round(y0_hat, 4), "\n")
# Verifica con lm().
mod <- lm(y ~ x, data = df)
summary(mod)
predict(mod, newdata = data.frame(x = x0))
plot(x, y,
xlab = "Ore di preparazione",
ylab = "Punteggio alla prova",
main = "Regressione lineare semplice")
abline(mod)
points(x0, y0_hat, pch = 16)
